# Public configuration only. Packaged Desktop uses the production URL from src/shared/links.ts.
STREAMCHAT_API_URL=https://api-streamchat.fromflamb.ru
# Optional public IDs for direct local development without the backend.
TWITCH_CLIENT_ID=
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET and YOUTUBE_API_KEY belong on stream-chat-api, not in a distributed Desktop build.
# Existing private development .env files are never packaged or deleted.
